{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "removeComments": true,
    "sourceMap": false,
    "declaration": false,
    "rootDir": "src",
    "outDir": "dist/framework-demo/engine"
  },
  "files": ["src/framework/ui/demo-entry.ts"]
}
