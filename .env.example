# Mimamori Care Ops deployment environment template
#
# Copy to a local, ignored .env file or configure these values in the
# deployment provider's secret/environment settings.
#
# Do not commit real credentials.
# Do not place membership-admin, outbox-provider, or backup-operator
# credentials in the ordinary Care Ops API runtime.

CARE_OPS_ENVIRONMENT=staging

SUPABASE_URL=https://your-project.supabase.co

# Required. Leave blank in this tracked template.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated canonical origins only. No paths, wildcards, queries,
# fragments, usernames, or passwords.
CARE_OPS_CONSOLE_ORIGINS=https://console.example.test

# Replace provider-a and thresholds with the approved tenant policy.
CARE_OPS_SLA_POLICIES_JSON={"provider-a":{"critical":{"acknowledgeWithinMs":120000,"assignWithinMs":120000,"firstActionWithinMs":120000,"handoffAcceptWithinMs":120000,"completeWithinMs":900000},"high":{"acknowledgeWithinMs":300000,"assignWithinMs":300000,"firstActionWithinMs":300000,"handoffAcceptWithinMs":300000,"completeWithinMs":1800000},"normal":{"acknowledgeWithinMs":600000,"assignWithinMs":300000,"firstActionWithinMs":300000,"handoffAcceptWithinMs":300000,"completeWithinMs":3600000},"low":{"acknowledgeWithinMs":1800000,"assignWithinMs":1800000,"firstActionWithinMs":1800000,"handoffAcceptWithinMs":900000,"completeWithinMs":10800000}}}

# CareOps platform (staging server: npm run careops:staging).
# AI: "disabled" (default) or "local-rules" (network-free). External LLMs
# are intentionally not selectable.
CARE_OPS_AI_PROVIDER=disabled
CARE_OPS_UI_TENANT_ID=provider-a
CARE_OPS_HTTP_HOST=127.0.0.1
CARE_OPS_HTTP_PORT=8080
CARE_OPS_ESCALATION_INTERVAL_MS=60000

# Optional bounded overrides.
CARE_OPS_OUTBOUND_TIMEOUT_MS=5000
CARE_OPS_MAX_COMMAND_BODY_BYTES=32768

# Intentionally absent from this runtime:
# CARE_OPS_MEMBERSHIP_ADMIN_SECRET
# CARE_OPS_OUTBOX_PROVIDER_SECRET
# CARE_OPS_BACKUP_OPERATOR_SECRET
