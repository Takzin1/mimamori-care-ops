{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/care-ops.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/care-ops/:path*",
      "destination": "/api/care-ops?__care_ops_path=:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
